  "keyFeatures": [
    "User authentication and session management",
    "Two evaluation types: Permanencia and Nuevo Ingreso",
    "Multi-step data capture forms (personal, family, academic, career, economic, references)",
    "Document upload and validation with file size limits",
    "PDF generation for expedientes (dossiers)",
    "Certificate generation and validation",
    "Progress tracking for evaluation completion",
    "Encrypted evaluation IDs for security"
  ],
  "publicApiSurface": [
    "POST /auth/signin - User authentication",
    "POST /auth/signup - User registration",
    "POST /evaluacionvLife/validityEvaluation - Create or resume evaluation",
    "GET /evaluacionvLife/evaluacionView/:encryptedData - View evaluation details",
    "POST /capturePersonales/* - Capture personal data",
    "POST /captureFamiliares/* - Capture family data",
    "POST /captureAcademicos/* - Capture academic data",
    "POST /captureTrayectoria/* - Capture career trajectory",
    "POST /captureEconomicos/* - Capture economic data",
    "POST /captureReferencias/* - Capture references",
    "POST /FileUpload/* - Upload documents",
    "GET /Expediente/ExpedienteViewPdf/:evalID - Generate PDF report",
    "POST /Constancia/* - Generate certificate",
    "POST /Validator/* - Validate certificate"
  ]
}
